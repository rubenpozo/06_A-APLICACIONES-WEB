@model IEnumerable<EncuestasApp.Models.Respuesta>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TextoLibre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaRespuesta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pregunta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TextoLibre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaRespuesta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opcion.OpcionId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pregunta.PreguntaId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usuario.UsuarioId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.RespuestaId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.RespuestaId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.RespuestaId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
