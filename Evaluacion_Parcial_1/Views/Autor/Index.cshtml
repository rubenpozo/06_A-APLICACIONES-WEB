@model IEnumerable<Evaluacion_Parcial_1.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<h1>Autores</h1>

<p>
    <a asp-action="Create">Nuevo Autor</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaNacimiento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nacionalidad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaNacimiento)
            </td>
            <td>
                @Html.DisplayFor(model => item.Nacionalidad)
            </td>
            <td>
                <a asp-controller="Autor" asp-action="Edit" asp-route-id="@item.AutorId">Editar</a> |
                <a asp-controller="Autor" asp-action="Details" asp-route-id="@item.AutorId">Detalles</a> |
                <a asp-controller="Autor" asp-action="Delete" asp-route-id="@item.AutorId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
